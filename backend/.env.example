PROJECT_NAME="SMC Academy Referral API"
ENVIRONMENT="development"
SECRET_KEY="change_this_to_a_secure_random_secret_key_in_production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database URL
# For production PostgreSQL: postgresql+asyncpg://user:password@localhost:5432/smc_referral
# For local development/testing SQLite: sqlite+aiosqlite:///./smc_referral.db
DATABASE_URL="sqlite+aiosqlite:///./smc_referral.db"

# Telegram Bot Token (from BotFather)
BOT_TOKEN="your_telegram_bot_token_here"

# Webhook secret for verifying requests from Google Apps Script
WEBHOOK_SECRET="change_this_to_a_secure_webhook_secret_key"

# Google Form integration
# Full pre-fill viewform URL (confirmed working URL for SMC Academy registration form)
GOOGLE_FORM_BASE_URL="https://docs.google.com/forms/d/e/1FAIpQLSfECyZnd6SXkMCwouJH5AnBU_ehiDDjHizGgkZV_qhs5Ker8A/viewform?usp=pp_url"
# Confirmed referral pre-fill entry ID from the SMC Academy Google Form
GOOGLE_FORM_REFERRAL_ENTRY_ID="entry.1398965380"

# Telegram Mini App Frontend URL (update to production URL when deployed)
FRONTEND_URL="http://localhost:5173"
BACKEND_PUBLIC_URL="http://localhost:8000"
CORS_ALLOWED_ORIGINS="http://localhost:5173"

# Python path (needed for running uvicorn from backend/ directory)
PYTHONPATH=.
